{
  "name": "downbeat",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "Synchronized multi-device music playback over the web, hosted from a Mac.",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-id.mjs && tsc -b --noEmit && vite build",
    "preview": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@wasm-audio-decoders/flac": "^0.2.11",
    "opus-decoder": "^0.7.11",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.151.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261019.1": true,
    "fsevents@2.3.3": true
  }
}
