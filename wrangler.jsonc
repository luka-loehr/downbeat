{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "downbeat",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Without this, the asset layer answers top-level NAVIGATIONS to these
    // paths with the SPA before the Worker ever runs. API fetches were never
    // affected — but the Spotify OAuth callback is a navigation, and it was
    // being swallowed whole (the browser landed on the landing page with the
    // authorization code still in the URL, exchanged with nobody).
    "run_worker_first": ["/api/*", "/audio/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "RoomDO" },
      { "name": "SOURCE", "class_name": "SourceContainer" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RoomDO"] },
    { "tag": "v2", "new_sqlite_classes": ["SourceContainer"] }
  ],
  // The librespot audio source. `wrangler deploy` builds the Dockerfile and
  // pushes it to Cloudflare's registry; one instance per active room.
  "containers": [
    {
      "class_name": "SourceContainer",
      "image": "./source/Dockerfile",
      "max_instances": 2,
      "instance_type": "basic"
    }
  ],
  "r2_buckets": [{ "binding": "AUDIO", "bucket_name": "downbeat-audio" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "downbeat-sessions",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": { "crons": ["17 * * * *"] },
  "routes": [{ "pattern": "downbeat.lukaloehr.com", "custom_domain": true }],
  "workers_dev": true,
  "preview_urls": false,
  // invocation_logs off: at 50 audio packets a second, per-invocation records
  // are pure noise and a quota furnace. The structured quality events the
  // RoomDO and the container emit are the log.
  "observability": { "enabled": true, "logs": { "invocation_logs": false } },
  "vars": { "ENVIRONMENT": "production" }
}
